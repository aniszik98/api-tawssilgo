# Copier ce fichier en .env sur le serveur et renseigner les valeurs.
# Ne JAMAIS commiter le .env (il est déjà dans .gitignore).

# Port d'écoute interne de l'API (Nginx fait le reverse proxy devant)
PORT=3000

# Base de données (exemple Supabase)
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=postgres
DB_SSL=true

# Clés API acceptées dans le header x-api-key, séparées par des virgules
API_KEYS=

# Synchronisation avec le backend Laravel (webhook sortant)
LARAVEL_WEBHOOK_URL=https://api.tawssilgo.com/api/webhooks/render-sync
# Clé partagée envoyée dans x-api-key lors des webhooks sortants
SYNC_API_KEY=
# Mettre à "false" pour couper les webhooks sortants sans redéployer
SYNC_WEBHOOK_ENABLED=true
